# Copy this file to .env and fill in from your Supabase project:
# Project Settings → API → Project URL / anon public key

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# — IBM watsonx.ai Credentials —
VITE_WATSONX_API_KEY=your_watsonx_api_key_here
VITE_WATSONX_PROJECT_ID=your_watsonx_project_id_here
VITE_WATSONX_URL=https://eu-de.ml.cloud.ibm.com

VITE_WATSONX_MODEL_ID=ibm/granite-3-8b-instruct
